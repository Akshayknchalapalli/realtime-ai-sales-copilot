AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b-instruct
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_TWO_STAGE=0
USE_FAISS=1
OLLAMA_MAX_OUTPUT_TOKENS=200
OLLAMA_CONTEXT_SIZE=4096

